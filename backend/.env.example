# Copie para backend/.env e ajuste. Todas as variáveis são opcionais.

# "development" devolve o código de redefinição de senha na resposta da API.
# Use "production" quando houver envio por e-mail/SMS.
ENVIRONMENT=development

# Chave para assinar os tokens de login. Sem ela, uma chave aleatória é criada em data/secret_key.
# SECRET_KEY=troque-por-um-valor-longo-e-aleatorio

# Quando definida, o gateway ESP32 precisa enviar o header X-API-Key com o mesmo valor
# (GATEWAY_API_KEY no receiver.ino).
# GATEWAY_API_KEY=

# Origens liberadas para o navegador, separadas por vírgula. "*" libera todas.
CORS_ORIGINS=*

# Anúncio na rede local (mDNS) para o gateway achar o servidor sem IP fixo.
# MDNS_ENABLED=true
# Porta do uvicorn, informada no anúncio. Mude junto com --port.
# API_PORT=8000

# Segundos sem leituras até o dispositivo aparecer como offline.
DEVICE_OFFLINE_SECONDS=90

# Duração da sessão.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
